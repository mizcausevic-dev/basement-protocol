{
  "name": "basement-protocol",
  "private": true,
  "version": "1.0.0",
  "description": "50 validated MIDI basslines for underground electronic music, with a browser lab that plays the real files.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pack": "python3 generator/basement_protocol.py",
    "validate": "python3 generator/validate.py && node scripts/validate-tonejs.mjs",
    "sync": "node scripts/sync-pack.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy-gh-pages.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tonejs/midi": "^2.0.28",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
